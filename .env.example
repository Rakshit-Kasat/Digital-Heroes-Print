# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=            # http://localhost:3000 locally, the Vercel URL in production
NEXT_PUBLIC_CURRENCY=           # GBP
NEXT_PUBLIC_VAT_RATE=           # 0.20

# --- Supabase (Project Settings > API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # safe in the browser; RLS protects data
SUPABASE_SECRET_KEY=                    # server only, bypasses RLS: never expose
SUPABASE_DB_PASSWORD=                   # only for running migrations

# --- Stripe (test mode: Developers > API keys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # pk_test_...
STRIPE_SECRET_KEY=                      # sk_test_...
STRIPE_WEBHOOK_SECRET=                  # whsec_... (from the webhook endpoint)

# --- Email (Gmail SMTP with an App Password) ---
SMTP_HOST=                              # smtp.gmail.com
SMTP_PORT=                              # 465
SMTP_USER=                              # the Gmail address
SMTP_PASS=                              # 16-letter Gmail App Password
EMAIL_FROM=                             # "Digital Heroes Print <address>"
